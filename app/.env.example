# Which data the interface reads. `mock` is the default and needs no chain.
VITE_DATA_SOURCE=mock

# Cluster and endpoint. The public endpoints are rate limited; use your own.
VITE_CLUSTER=devnet
# VITE_RPC_URL=https://your-provider.example/rpc

# Defaults to the address in idl/arclis.json, which the build generates from
# declare_id!. Override only to point at a second deployment.
# VITE_PROGRAM_ID=

# The quote mint every market settles in. Default is devnet USDC.
# VITE_QUOTE_MINT=

# Markets to list. Every address is derived from the symbol.
VITE_MARKETS=AAPL,NVDA,MSFT,TSLA,GOOGL

# How often to re-read the chain, in milliseconds.
VITE_REFRESH_MS=10000
