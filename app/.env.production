# Build-time configuration for a hosted deployment.
#
# Every value here is public. The program ID, the quote mint and the RPC
# endpoint are all readable by anyone who opens the site, because the browser
# has to know them to read the chain at all. Committing them is what makes a
# hosted build reproducible rather than dependent on somebody's local file.
#
# Nothing secret belongs in this file, and nothing secret can: anything
# prefixed VITE_ is compiled into the JavaScript every visitor downloads.
# The assistant's Anthropic key is deliberately absent - it lives only in the
# server process, and with VITE_ASSISTANT_URL unset the panel simply does not
# appear.

VITE_DATA_SOURCE=rpc
VITE_CLUSTER=devnet
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=BuN69a1vsMdPQx6bWjaA7FJMbnBKo6yZ66cHrdyiTbiP
VITE_QUOTE_MINT=8nMZjpyLpGGtnCkdCotT8jWUDUpSnJeVjeuazyYVvqGu
VITE_MARKETS=AAPL,NVDA,MSFT,TSLA,GOOGL

# A shared endpoint, polled by every visitor at once. Thirty seconds is
# already generous against api.devnet.solana.com.
VITE_REFRESH_MS=30000
VITE_SITE_URL=https://timioni001.github.io/stocklana-perp-engine
