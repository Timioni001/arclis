.anchor
target/
# ...but the generated IDL is committed under idl/, because a frontend cannot
# construct a single instruction without it and `anchor build --no-idl` never
# produces one. Regenerate with: python3 scripts/build-idl.py
node_modules/
dist/
build/
test-ledger/
.DS_Store
*.log

# Keypairs - never commit these.
**/*-keypair.json
!programs/**/keypair.json.example
.env
.env.*
!.env.example
# The one exception, and it is deliberate. A hosted build needs its
# configuration at build time, and every value in it is public by
# construction: anything VITE_-prefixed is compiled into the bundle that
# every visitor downloads. Nothing secret can live there, so nothing secret
# should ever be put there.
!app/.env.production

# Local editor state
.idea/
.vscode/

# Frontend build output
app/dist/
app/tsconfig.tsbuildinfo

# A generated registry snapshot. Never committed: a snapshot built from one
# person's RPC and router run would ship as "live" data that is actually a
# recording, which is precisely what this registry exists to stop other people
# doing. Generate it with `npm run registry:build`.
app/public/registry.json
pipeline/dist/

# Python bytecode, from running the asset scripts
__pycache__/
*.pyc

# Wrangler's local state and build cache.
.wrangler/
