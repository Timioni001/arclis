{
  "name": "arclis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint": "prettier --check 'tests/**/*.ts' 'src/**/*.ts'",
    "lint:fix": "prettier --write 'tests/**/*.ts' 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test:unit": "cargo test --lib",
    "test:dbc": "ts-mocha -p ./tsconfig.json -t 20000 'tests/dbc/**/*.test.ts'",
    "test:integration": "bash scripts/anchor-test.sh",
    "dbc:plan": "ts-node scripts/dbc-plan.ts",
    "dbc:monitor": "ts-node scripts/dbc-monitor.ts",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:test": "npm --prefix app test",
    "idl": "python3 scripts/build-idl.py",
    "assistant:typecheck": "tsc --noEmit",
    "keeper": "ts-node keeper/src/run.ts",
    "keeper:test": "npm --prefix app exec -- vitest run --root .. keeper pipeline",
    "registry:build": "ts-node pipeline/src/run.ts",
    "registry:prerender": "ts-node pipeline/src/prerender.ts",
    "assistant": "tsx server/dev.ts",
    "seed": "tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@coral-xyz/anchor": "^0.30.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.12",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "prettier": "^3.3.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "description": "Arclis - on-chain access to public markets."
}
